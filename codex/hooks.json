{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/log-session-start.sh\"",
            "statusMessage": "Logging Codex session start",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "hooks": [
          {
            "command": "echo \"Code discovery: prefer codebase-memory-mcp (search_graph, trace_path, get_code_snippet, query_graph, search_code) over grep/file-read; run index_repository first if the project is not indexed.\"",
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "bash '/home/weihung/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/log-stop.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}