{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$HOME/.codex/hooks/log-session-start.sh\"",
                        "timeout": 5,
                        "statusMessage": "Logging Codex session start"
                    }
                ]
            },
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo \"Code discovery: choose the matching codebase-memory-mcp tool and query the existing index directly; do not index before every search. If the project is not indexed, run index_repository once with its absolute path and retry. Re-index only when status or known-missing symbols indicate a stale graph.\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$HOME/.codex/hooks/log-stop.sh\"",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
